{
  "name": "hallpass-browser",
  "version": "1.3.0",
  "description": "Open any website in a browser your AI agent can drive and log in safely: credentials the agent can use but never read, with a hand-off to you for CAPTCHA/MFA. CLI, MCP server, and plugins for Claude Code, Codex, Gemini CLI and Antigravity.",
  "keywords": [
    "ai-agent",
    "browser",
    "login",
    "credentials",
    "mcp",
    "agent-browser",
    "claude-code",
    "codex",
    "gemini",
    "antigravity",
    "security"
  ],
  "license": "MIT",
  "author": {
    "name": "techgniouss"
  },
  "type": "module",
  "bin": {
    "hallpass": "bin/hallpass.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "skills",
    ".claude-plugin",
    ".codex-plugin",
    ".codex-mcp.json",
    ".agents/plugins",
    ".mcp.json",
    "gemini-extension.json",
    "GEMINI.md",
    "README.md",
    "SECURITY.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/audit.test.mjs test/refs.test.mjs test/request.test.mjs test/ops.test.mjs test/trust.test.mjs test/packaging.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.test.mjs",
    "test:mcp": "node --test --test-concurrency=1 test/mcp.test.mjs",
    "test:gate": "node --test --test-concurrency=1 test/gate.test.mjs",
    "test:detect": "node --test --test-concurrency=1 test/detect.test.mjs",
    "test:dialog": "node --test --test-concurrency=1 test/dialog.test.mjs",
    "test:browser": "node --test --test-concurrency=1 test/e2e.test.mjs test/mcp.test.mjs test/gate.test.mjs test/detect.test.mjs",
    "test:all": "npm test && npm run test:browser && npm run test:dialog",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techgniouss/hallpass-browser.git"
  },
  "homepage": "https://github.com/techgniouss/hallpass-browser#readme",
  "bugs": {
    "url": "https://github.com/techgniouss/hallpass-browser/issues"
  }
}
